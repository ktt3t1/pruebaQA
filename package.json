{
  "name": "azurian-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Prueba práctica QA Automation: Playwright + Cucumber + TypeScript + Allure",
  "scripts": {
    "test": "cucumber-js",
    "test:api": "cucumber-js --tags @api",
    "test:ui": "cucumber-js --tags @ui",
    "test:crear": "cucumber-js --tags @crear",
    "test:leer": "cucumber-js --tags @leer",
    "test:editar": "cucumber-js --tags @editar",
    "test:eliminar": "cucumber-js --tags @eliminar",
    "test:extras": "cucumber-js --tags \"@validaciones or @hibrido\"",
    "test:headed": "HEADED=true cucumber-js --tags @ui",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "clean": "rm -rf allure-results allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-cucumberjs": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
